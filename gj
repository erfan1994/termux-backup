/* =========================
   USER CHECK API
========================= */

/*
POST /api/user/check

{
  "username": "user1",
  "deviceId": "device-123"
}
*/

async function handleUserCheck(
  request,
  env
) {
  const db =
    new Database(env.KV);

  const data =
    await readBody(request);

  const username =
    safeText(
      data.username,
      50
    );

  const deviceId =
    safeText(
      data.deviceId,
      200
    );

  if (!username) {
    return json(
      {
        ok: false,
        error:
          "username_required"
      },
      400
    );
  }

  const user =
    await getUser(
      db,
      username
    );

  if (!user) {
    return json(
      {
        ok: false,
        error:
          "user_not_found"
      },
      404
    );
  }

  if (!userUsable(user)) {
    let reason =
      "disabled";

    if (
      user.expiresAt &&
      Number(user.expiresAt) <=
        Date.now()
    ) {
      reason = "expired";
    } else if (
      Number(user.quota || 0) > 0 &&
      Number(user.used || 0) >=
        Number(user.quota || 0)
    ) {
      reason =
        "quota_exceeded";
    }

    return json(
      {
        ok: false,
        username:
          user.username,
        reason,
        remaining:
          Math.max(
            0,
            Number(user.quota || 0) -
            Number(user.used || 0)
          )
      },
      403
    );
  }

  if (deviceId) {
    const devices =
      Array.isArray(user.devices)
        ? user.devices
        : [];

    if (!devices.includes(deviceId)) {
      if (
        devices.length >=
        Number(
          user.maxDevices || 1
        )
      ) {
        return json(
          {
            ok: false,
            error:
              "device_limit",
            maxDevices:
              Number(
                user.maxDevices || 1
              )
          },
          403
        );
      }

      user.devices =
        devices
          .concat(deviceId)
          .slice(0, 100);

      user.updatedAt =
        Date.now();

      await db.put(
        userKey(username),
        user
      );
    }
  }

  return json({
    ok: true,
    username:
      user.username,
    enabled:
      !!user.enabled,
    expiresAt:
      user.expiresAt,
    quota:
      Number(user.quota || 0),
    used:
      Number(user.used || 0),
    remaining:
      Math.max(
        0,
        Number(user.quota || 0) -
        Number(user.used || 0)
      ),
    maxDevices:
      Number(
        user.maxDevices || 1
      ),
    devices:
      Array.isArray(user.devices)
        ? user.devices.length
        : 0
  });
}

/* =========================
   USAGE REPORT
========================= */

/*
POST /api/usage/report

Header:
X-Usage-Secret: YOUR_SECRET

JSON:
{
  "username": "user1",
  "bytes": 123456
}
*/

async function handleUsageReport(
  request,
  env
) {
  if (!env.USAGE_REPORT_SECRET) {
    return json(
      {
        ok: false,
        error:
          "usage_reporting_not_configured"
      },
      503
    );
  }

  const supplied =
    request.headers.get(
      "X-Usage-Secret"
    ) || "";

  if (
    !supplied ||
    supplied !==
      env.USAGE_REPORT_SECRET
  ) {
    return json(
      {
        ok: false,
        error:
          "unauthorized"
      },
      401
    );
  }

  const db =
    new Database(env.KV);

  const data =
    await readBody(request);

  const username =
    safeText(
      data.username,
      50
    );

  const bytes =
    Number(data.bytes);

  if (
    !username ||
    !Number.isFinite(bytes) ||
    bytes < 0
  ) {
    return json(
      {
        ok: false,
        error:
          "invalid_request"
      },
      400
    );
  }

  const user =
    await getUser(
      db,
      username
    );

  if (!user) {
    return json(
      {
        ok: false,
        error:
          "user_not_found"
      },
      404
    );
  }

  user.used =
    Math.max(
      0,
      Number(user.used || 0) +
      Math.floor(bytes)
    );

  user.updatedAt =
    Date.now();

  await db.put(
    userKey(username),
    user
  );

  return json({
    ok: true,
    username:
      user.username,
    used:
      user.used,
    quota:
      Number(user.quota || 0),
    remaining:
      Math.max(
        0,
        Number(user.quota || 0) -
        user.used
      )
  });
}

