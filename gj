/**
 * AJB-VIP Cloudflare Worker
 * Single-file KV edition
 *
 * Required:
 *   KV -> Workers KV Namespace
 *
 * Optional:
 *   USAGE_REPORT_SECRET -> Secret
 */

const APP = {
  name: "AJB-VIP Panel",
  version: "5.0.0",
  sessionTTL: 8 * 60 * 60,
  loginWindow: 15 * 60,
  loginMax: 8,
  maxBody: 64 * 1024
};

const encoder = new TextEncoder();

/* =========================
   RESPONSE HELPERS
========================= */

function json(data, status = 200, headers = {}) {
  return new Response(JSON.stringify(data), {
    status,
    headers: Object.assign({
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    }, headers)
  });
}

function html(content, status = 200) {
  return new Response(content, {
    status,
    headers: {
      "content-type": "text/html; charset=utf-8",
      "cache-control": "no-store"
    }
  });
}

function redirect(url, cookie) {
  const headers = {
    location: url,
    "cache-control": "no-store"
  };

  if (cookie) {
    headers["set-cookie"] = cookie;
  }

  return new Response(null, {
    status: 302,
    headers
  });
}

/* =========================
   CRYPTO
========================= */

function randomBytes(length) {
  const bytes = new Uint8Array(length);
  crypto.getRandomValues(bytes);
  return bytes;
}

function bytesToHex(bytes) {
  let result = "";

  for (let i = 0; i < bytes.length; i++) {
    result += bytes[i].toString(16).padStart(2, "0");
  }

  return result;
}

function hexToBytes(hex) {
  if (!/^[0-9a-f]+$/i.test(hex) || hex.length % 2 !== 0) {
    throw new Error("Invalid hex");
  }

  const bytes = new Uint8Array(hex.length / 2);

  for (let i = 0; i < bytes.length; i++) {
    bytes[i] = parseInt(
      hex.substring(i * 2, i * 2 + 2),
      16
    );
  }

  return bytes;
}

function base64url(bytes) {
  let binary = "";

  for (let i = 0; i < bytes.length; i++) {
    binary += String.fromCharCode(bytes[i]);
  }

  return btoa(binary)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/g, "");
}

async function sha256(value) {
  const buffer = await crypto.subtle.digest(
    "SHA-256",
    encoder.encode(value)
  );

  return bytesToHex(new Uint8Array(buffer));
}

async function pbkdf2(password, saltHex, iterations) {
  const key = await crypto.subtle.importKey(
    "raw",
    encoder.encode(password),
    "PBKDF2",
    false,
    ["deriveBits"]
  );

  const bits = await crypto.subtle.deriveBits(
    {
      name: "PBKDF2",
      salt: hexToBytes(saltHex),
      iterations: iterations,
      hash: "SHA-256"
    },
    key,
    256
  );

  return bytesToHex(new Uint8Array(bits));
}

async function hashPassword(password) {
  const iterations = 120000;
  const salt = bytesToHex(randomBytes(16));
  const hash = await pbkdf2(password, salt, iterations);

  return {
    salt,
    hash,
    iterations
  };
}

async function verifyPassword(password, record) {
  if (!record) return false;
  if (!record.hash) return false;
  if (!record.salt) return false;

  const iterations = Number(record.iterations || 120000);

  const calculated = await pbkdf2(
    password,
    record.salt,
    iterations
  );

  return calculated === record.hash;
}

/* =========================
   BASIC HELPERS
========================= */

function safeText(value, maxLength) {
  return String(value || "")
    .trim()
    .substring(0, maxLength);
}

function escapeHTML(value) {
  return String(value || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function parseCookies(request) {
  const result = {};
  const cookie = request.headers.get("cookie") || "";

  for (const item of cookie.split(";")) {
    const index = item.indexOf("=");

    if (index === -1) continue;

    const name = item.substring(0, index).trim();
    const value = item.substring(index + 1).trim();

    result[name] = decodeURIComponent(value);
  }

  return result;
}

function sessionCookie(token) {
  return [
    "sid=" + encodeURIComponent(token),
    "Path=/",
    "HttpOnly",
    "Secure",
    "SameSite=Strict",
    "Max-Age=" + APP.sessionTTL
  ].join("; ");
}

function clearSessionCookie() {
  return [
    "sid=",
    "Path=/",
    "HttpOnly",
    "Secure",
    "SameSite=Strict",
    "Max-Age=0"
  ].join("; ");
}

function validUsername(username) {
  return /^[a-zA-Z0-9_.-]{3,50}$/.test(username);
}

function userKey(username) {
  return "user:" + username.toLowerCase();
}

function formatBytes(value) {
  let bytes = Number(value || 0);

  if (!Number.isFinite(bytes) || bytes <= 0) {
    return "0 B";
  }

  const units = ["B", "KB", "MB", "GB", "TB"];
  let index = 0;

  while (
    bytes >= 1024 &&
    index < units.length - 1
  ) {
    bytes /= 1024;
    index++;
  }

  return bytes.toFixed(index === 0 ? 0 : 2) +
    " " +
    units[index];
}

/* =========================
   KV DATABASE
========================= */

class Database {
  constructor(kv) {
    this.kv = kv;
  }

  async get(key, fallback = null) {
    const value = await this.kv.get(key);

    if (value === null) {
      return fallback;
    }

    try {
      return JSON.parse(value);
    } catch {
      return fallback;
    }
  }

  async put(key, value, options) {
    await this.kv.put(
      key,
      JSON.stringify(value),
      options
    );
  }

  async delete(key) {
    await this.kv.delete(key);
  }

  async list(prefix) {
    const result = [];
    let cursor = undefined;

    do {
      const page = await this.kv.list({
        prefix,
        cursor
      });

      for (const item of page.keys) {
        result.push(item.name);
      }

      if (page.list_complete) {
        cursor = undefined;
      } else {
        cursor = page.cursor;
      }
    } while (cursor);

    return result;
  }
}

/* =========================
   ADMIN / SESSION
========================= */

async function getAdmin(db) {
  return await db.get("admin");
}

async function createSession(db) {
  const token = base64url(randomBytes(32));

  await db.put(
    "session:" + token,
    {
      role: "admin",
      createdAt: Date.now(),
      expiresAt:
        Date.now() +
        APP.sessionTTL * 1000
    },
    {
      expirationTtl: APP.sessionTTL
    }
  );

  return token;
}

async function getSession(db, token) {
  if (!token) {
    return null;
  }

  const session = await db.get(
    "session:" + token
  );

  if (!session) {
    return null;
  }

  if (
    !session.expiresAt ||
    session.expiresAt <= Date.now()
  ) {
    await db.delete("session:" + token);
    return null;
  }

  return session;
}

async function requireAdmin(request, env) {
  const db = new Database(env.KV);
  const cookies = parseCookies(request);

  const session = await getSession(
    db,
    cookies.sid
  );

  if (!session) {
    return null;
  }

  if (session.role !== "admin") {
    return null;
  }

  return session;
}

/* =========================
   BODY
========================= */

async function readBody(request) {
  const length = Number(
    request.headers.get("content-length") || 0
  );

  if (length > APP.maxBody) {
    throw new Error("body_too_large");
  }

  const text = await request.text();

  if (text.length > APP.maxBody) {
    throw new Error("body_too_large");
  }

  if (!text) {
    return {};
  }

  const type =
    request.headers.get("content-type") || "";

  if (
    type.includes("application/json")
  ) {
    return JSON.parse(text);
  }

  return Object.fromEntries(
    new URLSearchParams(text)
  );
}

/* =========================
   LOGIN RATE LIMIT
========================= */

async function checkLoginRateLimit(db, ip) {
  const fingerprint = await sha256(ip);
  const key = "login:" + fingerprint;

  const now = Date.now();

  const current = await db.get(
    key,
    {
      count: 0,
      started: now
    }
  );

  if (
    now - current.started >
    APP.loginWindow * 1000
  ) {
    await db.put(
      key,
      {
        count: 1,
        started: now
      },
      {
        expirationTtl: APP.loginWindow
      }
    );

    return true;
  }

  if (
    current.count >= APP.loginMax
  ) {
    return false;
  }

  current.count++;

  await db.put(
    key,
    current,
    {
      expirationTtl: APP.loginWindow
    }
  );

  return true;
}

