/* =========================
   ADD USER
========================= */

async function handleAdd(
  request,
  env
) {
  const admin =
    await requireAdmin(
      request,
      env
    );

  if (!admin) {
    return redirect("/login");
  }

  const db =
    new Database(env.KV);

  const data =
    await readBody(request);

  const username =
    safeText(data.username, 50);

  if (!validUsername(username)) {
    return redirect(
      "/panel?e=نام%20کاربری%20نامعتبر"
    );
  }

  const existing =
    await getUser(
      db,
      username
    );

  if (existing) {
    return redirect(
      "/panel?e=این%20کاربر%20از%20قبل%20وجود%20دارد"
    );
  }

  const quotaGb =
    Number(data.quotaGb || 0);

  const maxDevices =
    Number(data.maxDevices || 1);

  if (
    !Number.isFinite(quotaGb) ||
    quotaGb < 0
  ) {
    return redirect(
      "/panel?e=سهمیه%20نامعتبر"
    );
  }

  if (
    !Number.isInteger(maxDevices) ||
    maxDevices < 1 ||
    maxDevices > 100
  ) {
    return redirect(
      "/panel?e=تعداد%20دستگاه%20نامعتبر"
    );
  }

  let expiresAt = null;

  if (data.expiresAt) {
    const timestamp =
      new Date(
        data.expiresAt
      ).getTime();

    if (
      Number.isFinite(timestamp)
    ) {
      expiresAt = timestamp;
    }
  }

  const user = {
    username,
    enabled: true,
    quota: Math.round(
      quotaGb *
      1024 *
      1024 *
      1024
    ),
    used: 0,
    expiresAt,
    maxDevices,
    devices: [],
    note: safeText(
      data.note,
      120
    ),
    createdAt: Date.now(),
    updatedAt: Date.now()
  };

  await db.put(
    userKey(username),
    user
  );

  return redirect(
    "/panel?ok=کاربر%20با%20موفقیت%20ساخته%20شد"
  );
}

