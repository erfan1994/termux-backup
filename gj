/* =========================
   ROUTER
========================= */

async function router(
  request,
  env
) {
  if (!env.KV) {
    return html(
      basePage(
        "خطا",
        [
          '<div class="login">',
          "<h1>KV پیدا نشد</h1>",
          "<p>",
          "یک Workers KV Namespace بسازید ",
          "و Binding آن را دقیقاً ",
          "<b>KV</b>",
          " قرار دهید.",
          "</p>",
          "</div>"
        ].join("")
      ),
      500
    );
  }

  const url =
    new URL(request.url);

  const path =
    url.pathname;

  try {
    if (
      path === "/setup"
    ) {
      return await handleSetup(
        request,
        env
      );
    }

    if (
      path === "/login"
    ) {
      return await handleLogin(
        request,
        env
      );
    }

    if (
      path === "/logout"
    ) {
      return await handleLogout(
        request,
        env
      );
    }

    if (
      path === "/" ||
      path === "/panel"
    ) {
      return await handlePanel(
        request,
        env
      );
    }

    if (
      path === "/admin/add" &&
      request.method === "POST"
    ) {
      return await handleAdd(
        request,
        env
      );
    }

    if (
      path === "/admin/toggle" &&
      request.method === "POST"
    ) {
      return await handleToggle(
        request,
        env
      );
    }

    if (
      path === "/admin/reset" &&
      request.method === "POST"
    ) {
      return await handleReset(
        request,
        env
      );
    }

    if (
      path === "/admin/delete" &&
      request.method === "POST"
    ) {
      return await handleDelete(
        request,
        env
      );
    }

    if (
      path === "/api/user/check" &&
      request.method === "POST"
    ) {
      return await handleUserCheck(
        request,
        env
      );
    }

    if (
      path === "/api/usage/report" &&
      request.method === "POST"
    ) {
      return await handleUsageReport(
        request,
        env
      );
    }

    if (
      path === "/api/subscription" &&
      request.method === "GET"
    ) {
      return await handleSubscription(
        request,
        env
      );
    }

    return json(
      {
        ok: false,
        error: "not_found"
      },
      404
    );

  } catch (error) {
    console.error(
      "Worker error:",
      error
    );

    if (
      path.startsWith("/api/")
    ) {
      return json(
        {
          ok: false,
          error:
            "internal_error"
        },
        500
      );
    }

    return html(
      basePage(
        "خطا",
        [
          '<div class="login">',
          "<h1>خطای داخلی</h1>",
          "<p>",
          "در پردازش درخواست خطایی رخ داد.",
          "</p>",
          "</div>"
        ].join("")
      ),
      500
    );
  }
}

