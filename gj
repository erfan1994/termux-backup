/* =========================
   USERS
========================= */

async function getUser(db, username) {
  return await db.get(
    userKey(username)
  );
}

async function getAllUsers(db) {
  const keys = await db.list("user:");
  const users = [];

  for (const key of keys) {
    const user = await db.get(key);

    if (user) {
      users.push(user);
    }
  }

  users.sort(function(a, b) {
    return a.username.localeCompare(
      b.username
    );
  });

  return users;
}

function userUsable(user) {
  if (!user) {
    return false;
  }

  if (!user.enabled) {
    return false;
  }

  if (
    user.expiresAt &&
    Number(user.expiresAt) <= Date.now()
  ) {
    return false;
  }

  if (
    Number(user.quota || 0) > 0 &&
    Number(user.used || 0) >=
      Number(user.quota || 0)
  ) {
    return false;
  }

  return true;
}

/* =========================
   SETUP
========================= */

async function handleSetup(
  request,
  env
) {
  const db = new Database(env.KV);

  const admin =
    await getAdmin(db);

  if (admin) {
    return redirect("/panel");
  }

  if (request.method === "GET") {
    return html(setupPage(""));
  }

  const data =
    await readBody(request);

  const username =
    safeText(data.username, 40);

  const password =
    String(data.password || "");

  const password2 =
    String(data.password2 || "");

  if (
    !/^[a-zA-Z0-9_.-]{3,40}$/.test(
      username
    )
  ) {
    return html(
      setupPage(
        "نام کاربری نامعتبر است."
      )
    );
  }

  if (password.length < 8) {
    return html(
      setupPage(
        "رمز عبور باید حداقل ۸ کاراکتر باشد."
      )
    );
  }

  if (password !== password2) {
    return html(
      setupPage(
        "تکرار رمز عبور صحیح نیست."
      )
    );
  }

  const existing =
    await getAdmin(db);

  if (existing) {
    return redirect("/panel");
  }

  const passwordData =
    await hashPassword(password);

  await db.put(
    "admin",
    {
      username,
      hash: passwordData.hash,
      salt: passwordData.salt,
      iterations:
        passwordData.iterations,
      createdAt: Date.now()
    }
  );

  return redirect("/panel");
}

/* =========================
   LOGIN
========================= */

async function handleLogin(
  request,
  env
) {
  const db = new Database(env.KV);

  const admin =
    await getAdmin(db);

  if (!admin) {
    return redirect("/setup");
  }

  if (request.method === "GET") {
    return html(loginPage(""));
  }

  const ip =
    request.headers.get(
      "CF-Connecting-IP"
    ) || "unknown";

  const allowed =
    await checkLoginRateLimit(
      db,
      ip
    );

  if (!allowed) {
    return html(
      loginPage(
        "تعداد تلاش‌های ورود زیاد است. بعداً دوباره امتحان کنید."
      )
    );
  }

  const data =
    await readBody(request);

  const username =
    safeText(data.username, 40);

  const password =
    String(data.password || "");

  const valid =
    username === admin.username &&
    await verifyPassword(
      password,
      admin
    );

  if (!valid) {
    return html(
      loginPage(
        "نام کاربری یا رمز عبور اشتباه است."
      )
    );
  }

  const token =
    await createSession(db);

  return redirect(
    "/panel",
