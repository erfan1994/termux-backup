========================= */

function dashboard(users, noticeType, noticeText) {
  let active = 0;
  let disabled = 0;
  let quota = 0;
  let used = 0;

  for (const user of users) {
    if (user.enabled) {
      active++;
    } else {
      disabled++;
    }

    quota += Number(user.quota || 0);
    used += Number(user.used || 0);
  }

  let notice = "";

  if (noticeText) {
    notice =
      '<div class="' +
      (noticeType === "success"
        ? "success"
        : "alert") +
      '">' +
      escapeHTML(noticeText) +
      "</div>";
  }

  let rows = "";

  for (const user of users) {
    const userQuota =
      Number(user.quota || 0);

    const userUsed =
      Number(user.used || 0);

    const remaining = Math.max(
      0,
      userQuota - userUsed
