    <script>
        // ==================== STATE ====================
        let users = [];
        let currentUser = null;
        let currentPage = 'dashboard';

        // ==================== DOM REFS ====================
        const $ = id => document.getElementById(id);

        // ==================== TOAST ====================
        function showToast(message, type = 'success') {
            const container = $('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(30px)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ==================== API ====================
        async function api(method, endpoint, data) {
            const opts = { method, headers: { 'Content-Type': 'application/json' } };
            if (data) opts.body = JSON.stringify(data);
            const res = await fetch(endpoint, opts);
            const json = await res.json();
            if (!json.success) throw new Error(json.message || 'API error');
            return json;
        }

        // ==================== AUTH ====================
        async function login(username, password) {
            const res = await api('POST', '/ajb/api/login', { username, password });
            currentUser = res.user;
            showToast('Login successful!');
            return res;
        }

        async function logout() {
            await api('POST', '/ajb/api/logout');
            currentUser = null;
            showToast('Logged out');
        }

        async function checkAuth() {
            try {
                const res = await api('GET', '/ajb/api/me');
                currentUser = res.user;
                return true;
            } catch {
                return false;
            }
        }

        // ==================== USERS CRUD ====================
        async function loadUsers() {
            const res = await api('GET', '/ajb/api/users');
            users = res.users;
            renderUsers();
            updateStats();
            renderSubscriptions();
            return users;
        }

        async function addUser(data) {
            const res = await api('POST', '/ajb/api/users', data);
            await loadUsers();
            showToast('User created successfully!');
            return res;
        }

        async function updateUser(username, data) {
            const res = await api('PUT', `/ajb/api/users/${username}`, data);
            await loadUsers();
            showToast('User updated successfully!');
            return res;
        }

        async function deleteUser(username) {
            if (!confirm(`Delete user "${username}"?`)) return;
            await api('DELETE', `/ajb/api/users/${username}`);
            await loadUsers();
            showToast('User deleted');
        }

        async function resetTraffic(username) {
            await api('POST', `/ajb/api/users/${username}/reset`);
            await loadUsers();
            showToast('Traffic reset!');
        }

        // ==================== RENDER ====================
        function renderUsers() {
            const tbody = $('usersTableBody');
            const search = $('userSearch')?.value?.toLowerCase() || '';
            const filtered = users.filter(u => u.username !== 'admin' && u.username.toLowerCase().includes(search));

            tbody.innerHTML = filtered.map(u => {
                const remaining = u.traffic_limit - u.traffic_used;
                const percent = u.traffic_limit > 0 ? Math.min((u.traffic_used / u.traffic_limit) * 100, 100) : 0;
                const isExpired = new Date(u.expiry_date) < new Date();
                const status = !u.is_active ? 'inactive' : isExpired ? 'expired' : 'active';
                const statusMap = {
                    active: '<span class="status-badge active">Active</span>',
                    expired: '<span class="status-badge expired">Expired</span>',
                    inactive: '<span class="status-badge inactive">Inactive</span>'
                };

                let barClass = 'fill';
                if (percent > 80) barClass += ' danger';
                else if (percent > 50) barClass += ' warning';

                return `
                    <tr>
                        <td><strong>${u.username}</strong></td>
                        <td>
                            ${u.traffic_used.toFixed(2)} / ${u.traffic_limit} GB
                            <div class="traffic-bar"><div class="${barClass}" style="width: ${percent}%;"></div></div>
                        </td>
                        <td>${new Date(u.expiry_date).toLocaleDateString()}</td>
                        <td>${statusMap[status]}</td>
                        <td>
                            <button class="btn btn-success btn-sm" onclick="resetTraffic('${u.username}')">↺</button>
                            <button class="btn btn-warning btn-sm" onclick="editUser('${u.username}')">✎</button>
                            <button class="btn btn-danger btn-sm" onclick="deleteUser('${u.username}')">×</button>
                        </td>
                    </tr>
                `;
            }).join('');

            $('userCount').textContent = filtered.length;
        }

        function updateStats() {
            const nonAdmin = users.filter(u => u.username !== 'admin');
            const total = nonAdmin.length;
            const active = nonAdmin.filter(u => u.is_active && new Date(u.expiry_date) > new Date()).length;
            const totalTraffic = nonAdmin.reduce((s, u) => s + u.traffic_limit, 0);
            const usedTraffic = nonAdmin.reduce((s, u) => s + u.traffic_used, 0);

            $('statTotal').textContent = total;
            $('statActive').textContent = active;
            $('statTraffic').textContent = totalTraffic.toFixed(0) + ' GB';
            $('statUsed').textContent = usedTraffic.toFixed(1) + ' GB';
        }

        function renderSubscriptions() {
            const tbody = $('subscriptionsTableBody');
            const nonAdmin = users.filter(u => u.username !== 'admin');

            tbody.innerHTML = nonAdmin.map(u => {
                const isExpired = new Date(u.expiry_date) < new Date();
                const status = !u.is_active ? 'inactive' : isExpired ? 'expired' : 'active';
                const statusMap = {
                    active: '<span class="status-badge active">Active</span>',
                    expired: '<span class="status-badge expired">Expired</span>',
                    inactive: '<span class="status-badge inactive">Inactive</span>'
                };
                const url = window.location.origin + '/ajb/sub/' + u.subscription_id;
                return `
                    <tr>
                        <td><strong>${u.username}</strong></td>
                        <td style="font-size: 12px; word-break: break-all; color: var(--text-muted);">${url}</td>
                        <td>${statusMap[status]}</td>
                        <td>
