const CONFIG = {
    PANEL_NAME: 'AJB-VIP',
    PANEL_VERSION: '2.0.0',
    ADMIN_USERNAME: 'admin',
    ADMIN_PASSWORD: 'admin123',
    DEFAULT_TRAFFIC: 10,
    DEFAULT_EXPIRY_DAYS: 30,
    MAX_USERS: 100,
};

// ==================== توابع کمکی ====================
function generateToken() {
    return crypto.randomUUID();
}

function getExpiryDate(days) {
    return new Date(Date.now() + days * 86400000).toISOString();
}

function isExpired(expiryDate) {
    return new Date(expiryDate) < new Date();
}

function jsonResponse(data, status = 200) {
    return new Response(JSON.stringify(data), {
        status: status,
        headers: { 'Content-Type': 'application/json' }
    });
}

function htmlResponse(html, status = 200) {
    return new Response(html, {
        status: status,
        headers: { 'Content-Type': 'text/html; charset=utf-8' }
    });
}

// ==================== کلاس دیتابیس ====================
class Database {
    constructor(env) {
        this.env = env;
        this.kv = env.KV || env.kv;
    }

    async init() {
        await this.ensureUsers();
        await this.ensureSettings();
    }

    async ensureUsers() {
        const users = await this.kv.get('ajb_users', { type: 'json' });
        if (!users) {
            const defaultUsers = {
                admin: {
                    username: CONFIG.ADMIN_USERNAME,
                    password: CONFIG.ADMIN_PASSWORD,
                    role: 'admin',
                    created_at: new Date().toISOString()
                }
            };
            await this.kv.put('ajb_users', JSON.stringify(defaultUsers));
        }
    }

    async ensureSettings() {
        const settings = await this.kv.get('ajb_settings', { type: 'json' });
        if (!settings) {
            await this.kv.put('ajb_settings', JSON.stringify({
                default_traffic: CONFIG.DEFAULT_TRAFFIC,
                default_expiry: CONFIG.DEFAULT_EXPIRY_DAYS
            }));
        }
    }

    async getUsers() {
        const data = await this.kv.get('ajb_users', { type: 'json' });
        return data || {};
    }

    async saveUsers(users) {
        await this.kv.put('ajb_users', JSON.stringify(users));
    }

    async getUser(username) {
        const users = await this.getUsers();
        return users[username] || null;
    }

    async createUser(username, data) {
        const users = await this.getUsers();
        
        if (users[username]) {
            throw new Error('کاربر از قبل وجود دارد');
        }
        
        if (Object.keys(users).length >= CONFIG.MAX_USERS) {
            throw new Error('تعداد کاربران به حداکثر رسیده است');
        }

        const newUser = {
            username: username,
            password: data.password || generateToken().slice(0, 8),
            role: data.role || 'user',
            traffic_limit: data.traffic_limit || CONFIG.DEFAULT_TRAFFIC,
            traffic_used: 0,
            expiry_date: data.expiry_date || getExpiryDate(CONFIG.DEFAULT_EXPIRY_DAYS),
            is_active: data.is_active !== false,
            subscription_id: generateToken(),
            created_at: new Date().toISOString(),
            last_seen: null
        };

        users[username] = newUser;
        await this.saveUsers(users);
        return newUser;
    }

    async updateUser(username, data) {
        const users = await this.getUsers();
        
        if (!users[username]) {
            throw new Error('کاربر پیدا نشد');
        }

        users[username] = { ...users[username], ...data };
        await this.saveUsers(users);
        return users[username];
    }

    async deleteUser(username) {
        if (username === 'admin') {
            throw new Error('امکان حذف کاربر ادمین وجود ندارد');
        }

        const users = await this.getUsers();
        delete users[username];
        await this.saveUsers(users);
        return true;
    }

    async resetTraffic(username) {
        const users = await this.getUsers();
        
        if (!users[username]) {
            throw new Error('کاربر پیدا نشد');
        }

        users[username].traffic_used = 0;
        await this.saveUsers(users);
        return users[username];
    }

    async getSubscription(id) {
        const users = await this.getUsers();
        
        for (const [username, user] of Object.entries(users)) {
            if (user.subscription_id === id) {
                return { username, ...user };
            }
        }
        return null;
    }

    async getStats() {
        const users = await this.getUsers();
        const stats = {
            total: 0,
            active: 0,
            expired: 0,
            total_traffic: 0,
            used_traffic: 0
        };

        for (const [username, user] of Object.entries(users)) {
            if (username === 'admin') continue;
            
            stats.total++;
            
            if (user.is_active && !isExpired(user.expiry_date)) {
                stats.active++;
            } else {
                stats.expired++;
            }
            
            stats.total_traffic += user.traffic_limit || 0;
            stats.used_traffic += user.traffic_used || 0;
        }

        return stats;
    }

    async getSettings() {
        const settings = await this.kv.get('ajb_settings', { type: 'json' });
        return settings || {
            default_traffic: CONFIG.DEFAULT_TRAFFIC,
            default_expiry: CONFIG.DEFAULT_EXPIRY_DAYS
        };
    }

    async saveSettings(settings) {
        await this.kv.put('ajb_settings', JSON.stringify(settings));
        return settings;
    }
}

// ==================== کلاس مدیریت نشست ====================
class SessionManager {
    constructor() {
        this.sessions = new Map();
    }

    createSession(username) {
        const token = generateToken();
        this.sessions.set(token, {
            username: username,
            expires: Date.now() + 86400000
        });
        return token;
    }

    validateSession(token) {
        const session = this.sessions.get(token);
        
        if (!session) return null;
        
        if (session.expires < Date.now()) {
            this.sessions.delete(token);
            return null;
        }
        
        return session;
    }

    deleteSession(token) {
        this.sessions.delete(token);
    }

    async getUserFromRequest(request, db) {
        const cookie = request.headers.get('Cookie');
        if (!cookie) return null;

        const match = cookie.match(/ajb_session=([^;]+)/);
        if (!match) return null;

        const session = this.validateSession(match[1]);
        if (!session) return null;

        const user = await db.getUser(session.username);
        return user;
    }

    createSessionCookie(token) {
        return `ajb_session=${token}; Path=/; HttpOnly; Max-Age=86400; SameSite=Strict`;
    }

    deleteSessionCookie() {
        return 'ajb_session=; Path=/; Max-Age=0; HttpOnly';
    }
}

// ==================== هندلرهای API ====================
async function handleLogin(db, sessionManager, request) {
    try {
        const { username, password } = await request.json();
        const user = await db.getUser(username);
        
        if (!user || user.password !== password) {
            return jsonResponse({ 
                success: false, 
                message: 'نام کاربری یا رمز عبور اشتباه است' 
            }, 401);
        }

        const token = sessionManager.createSession(username);
        const response = jsonResponse({
            success: true,
            user: { username: user.username, role: user.role }
        });

        response.headers.set('Set-Cookie', sessionManager.createSessionCookie(token));
        return response;

    } catch (error) {
        return jsonResponse({ success: false, message: 'خطا در ورود' }, 500);
    }
}

async function handleLogout(sessionManager, request) {
    const cookie = request.headers.get('Cookie');
    if (cookie) {
        const match = cookie.match(/ajb_session=([^;]+)/);
        if (match) {
            sessionManager.deleteSession(match[1]);
        }
    }

    const response = jsonResponse({ success: true });
    response.headers.set('Set-Cookie', sessionManager.deleteSessionCookie());
    return response;
}

async function handleMe(sessionManager, db, request) {
    const user = await sessionManager.getUserFromRequest(request, db);
    
    if (!user) {
        return jsonResponse({ success: false, message: 'احراز هویت نشده' }, 401);
    }

    return jsonResponse({
        success: true,
        user: { username: user.username, role: user.role }
    });
}

async function handleGetUsers(db) {
    try {
        const users = await db.getUsers();
        const userList = Object.values(users).filter(u => u.username !== 'admin');
        return jsonResponse({ success: true, users: userList });
    } catch (error) {
        return jsonResponse({ success: false, message: 'خطا در دریافت کاربران' }, 500);
    }
}

async function handleCreateUser(db, request) {
    try {
        const data = await request.json();
        
        if (!data.username || data.username.length < 3) {
            return jsonResponse({ success: false, message: 'نام کاربری باید حداقل ۳ کاراکتر باشد' }, 400);
        }

        const user = await db.createUser(data.username, {
            password: data.password,
            traffic_limit: data.traffic_limit,
            expiry_days: data.expiry_days,
            is_active: data.is_active
        });

        return jsonResponse({ success: true, user: user });
    } catch (error) {
        return jsonResponse({ success: false, message: error.message }, 400);
    }
}

async function handleUpdateUser(db, request, username) {
    try {
        const data = await request.json();
        const user = await db.updateUser(username, data);
        return jsonResponse({ success: true, user: user });
    } catch (error) {
        return jsonResponse({ success: false, message: error.message }, 400);
    }
}

async function handleDeleteUser(db, username) {
    try {
        await db.deleteUser(username);
        return jsonResponse({ success: true });
    } catch (error) {
        return jsonResponse({ success: false, message: error.message }, 400);
    }
}

async function handleResetTraffic(db, username) {
    try {
        const user = await db.resetTraffic(username);
        return jsonResponse({ success: true, user: user });
    } catch (error) {
        return jsonResponse({ success: false, message: error.message }, 400);
    }
}

async function handleGetStats(db) {
    try {
        const stats = await db.getStats();
        return jsonResponse({ success: true, stats: stats });
    } catch (error) {
        return jsonResponse({ success: false, message: 'خطا در دریافت آمار' }, 500);
    }
}

async function handleGetSettings(db) {
    try {
        const settings = await db.getSettings();
        return jsonResponse({ success: true, ...settings });
    } catch (error) {
        return jsonResponse({ success: false, message: 'خطا در دریافت تنظیمات' }, 500);
    }
}

async function handleSaveSettings(db, request) {
    try {
        const data = await request.json();
        await db.saveSettings(data);
        return jsonResponse({ success: true });
    } catch (error) {
        return jsonResponse({ success: false, message: error.message }, 400);
    }
}

async function handleChangePassword(db, sessionManager, request) {
    try {
        const user = await sessionManager.getUserFromRequest(request, db);
        if (!user) {
            return jsonResponse({ success: false, message: 'احراز هویت نشده' }, 401);
        }

        const { password } = await request.json();
        
        if (!password || password.length < 6) {
            return jsonResponse({ 
                success: false, 
                message: 'رمز عبور باید حداقل ۶ کاراکتر باشد' 
            }, 400);
        }

        await db.updateUser(user.username, { password: password });
        return jsonResponse({ success: true });

    } catch (error) {
        return jsonResponse({ success: false, message: error.message }, 400);
    }
}

async function handleGetSubscription(db, id) {
    try {
        const subscription = await db.getSubscription(id);
        
        if (!subscription) {
            return jsonResponse({ success: false, message: 'اشتراک معتبر نیست' }, 404);
        }

        if (!subscription.is_active || isExpired(subscription.expiry_date)) {
            return jsonResponse({ success: false, message: 'اشتراک منقضی شده است' }, 403);
        }

        const config = {
            v: '2',
            ps: `AJB-VIP-${subscription.username}`,
            add: 'proxy.example.com',
            port: '443',
            id: subscription.subscription_id,
            aid: '0',
            net: 'ws',
            type: 'none',
            host: 'proxy.example.com',
            path: '/',
            tls: 'tls'
        };

        return jsonResponse({ success: true, config: config });

    } catch (error) {
        return jsonResponse({ success: false, message: 'خطا در دریافت اشتراک' }, 500);
    }
}

// ==================== مسیریاب API ====================
async function handleAPI(request, db, sessionManager) {
    const url = new URL(request.url);
    const path = url.pathname.replace('/ajb/api/', '');

    // مسیرهای عمومی
    if (path === 'login' && request.method === 'POST') {
        return handleLogin(db, sessionManager, request);
    }

    if (path === 'logout' && request.method === 'POST') {
        return handleLogout(sessionManager, request);
    }

    // بررسی احراز هویت
    const user = await sessionManager.getUserFromRequest(request, db);
    if (!user) {
        return jsonResponse({ success: false, message: 'احراز هویت نشده' }, 401);
    }

    // مسیرهای محافظت شده
    switch (path) {
        case 'me':
            if (request.method === 'GET') {
                return handleMe(sessionManager, db, request);
            }
            break;

        case 'users':
            if (request.method === 'GET') {
                return handleGetUsers(db);
            }
            if (request.method === 'POST') {
                return handleCreateUser(db, request);
            }
            break;

        case 'stats':
            if (request.method === 'GET') {
                return handleGetStats(db);
            }
            break;

        case 'settings':
            if (request.method === 'GET') {
                return handleGetSettings(db);
            }
            if (request.method === 'POST') {
                return handleSaveSettings(db, request);
            }
            break;

        case 'change-password':
            if (request.method === 'POST') {
                return handleChangePassword(db, sessionManager, request);
            }
            break;

        default:
            if (path.startsWith('users/')) {
                const username = path.replace('users/', '');
                
                if (request.method === 'PUT') {
                    return handleUpdateUser(db, request, username);
                }
                if (request.method === 'DELETE') {
                    return handleDeleteUser(db, username);
                }
                if (request.method === 'POST' && path.endsWith('/reset')) {
                    return handleResetTraffic(db, username);
                }
            }
            
            if (path.startsWith('sub/')) {
                const id = path.replace('sub/', '');
                if (request.method === 'GET') {
                    return handleGetSubscription(db, id);
                }
            }
            break;
    }

    return jsonResponse({ success: false, message: 'مسیر پیدا نشد' }, 404);
}

