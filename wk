// بخش ۵: توابع مدیریت کاربران
// ============================================================

async function handleGetUsers(db) {
    try {
        const users = await db.getUsers();
        const userList = Object.values(users).filter(u => u.username !== 'admin');
        return jsonResponse({ success: true, users: userList });
    } catch (error) {
        logError('خطا در دریافت کاربران', error);
        return jsonResponse({ success: false, message: 'خطا در دریافت کاربران' }, 500);
    }
}

async function handleCreateUser(db, request) {
    try {
        const data = await request.json();
        
        // اعتبارسنجی
        if (!data.username || data.username.length < 3) {
            return jsonResponse({ success: false, message: 'نام کاربری باید حداقل ۳ کاراکتر باشد' }, 400);
        }

        const user = await db.createUser(data.username, {
            password: data.password,
            traffic_limit: data.traffic_limit,
            expiry_days: data.expiry_days,
            is_active: data.is_active
        });

        return jsonResponse({ success: true, user: user });
    } catch (error) {
        return jsonResponse({ success: false, message: error.message }, 400);
    }
}

async function handleUpdateUser(db, request, username) {
    try {
        const data = await request.json();
        const user = await db.updateUser(username, data);
        return jsonResponse({ success: true, user: user });
    } catch (error) {
        return jsonResponse({ success: false, message: error.message }, 400);
    }
}

async function handleDeleteUser(db, username) {
    try {
        await db.deleteUser(username);
        return jsonResponse({ success: true });
    } catch (error) {
        return jsonResponse({ success: false, message: error.message }, 400);
    }
}

async function handleResetTraffic(db, username) {
    try {
        const user = await db.resetTraffic(username);
        return jsonResponse({ success: true, user: user });
    } catch (error) {
        return jsonResponse({ success: false, message: error.message }, 400);
    }
}
