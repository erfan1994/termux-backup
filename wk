// ترکیب HTML
const FULL_HTML = PANEL_HTML + LOGIN_PAGE + DASHBOARD_PAGE + PAGES_HTML + MODAL_HTML;

// Worker اصلی
export default {
    async fetch(request, env) {
        const url = new URL(request.url);
        const path = url.pathname;

        try {
            // مقداردهی اولیه
            const db = new Database(env);
            await db.init();
            const sessionManager = new SessionManager();

            // مسیرهای API
            if (path.startsWith('/ajb/api/')) {
                return await handleAPI(request, db, sessionManager);
            }

            // مسیرهای اشتراک
            if (path.startsWith('/ajb/sub/')) {
                const id = path.replace('/ajb/sub/', '');
                const subscription = await db.getSubscription(id);

                if (!subscription) {
                    return new Response('Invalid subscription', { status: 404 });
                }

                if (!subscription.is_active || isExpired(subscription.expiry_date)) {
                    return new Response('Subscription expired or inactive', { status: 403 });
                }

                // کانفیگ نمونه
                const config = {
                    v: '2',
                    ps: `AJB-VIP-${subscription.username}`,
                    add: 'proxy.example.com',
                    port: '443',
                    id: subscription.subscription_id,
                    aid: '0',
                    net: 'ws',
                    type: 'none',
                    host: 'proxy.example.com',
                    path: '/',
                    tls: 'tls'
                };

                return new Response(JSON.stringify(config), {
                    headers: {
                        'Content-Type': 'application/json',
                        'Cache-Control': 'no-store',
                        'Profile-Title': `AJB-VIP-${subscription.username}`
                    }
                });
            }

            // پنل مدیریت
            if (path === '/ajb' || path === '/ajb/' || path === '/') {
                if (path === '/') {
                    return Response.redirect('/ajb', 302);
                }
                return new Response(FULL_HTML, {
                    headers: { 'Content-Type': 'text/html; charset=utf-8' }
                });
            }

            return new Response('Not Found', { status: 404 });

        } catch (error) {
            logError('خطا در Worker', error);
            return new Response('Internal Server Error', { status: 500 });
        }
    }
};
