const CONFIG = {
    NAME: "AJB-VIP",
    VERSION: "3.0.0",

    SESSION_TTL: 24 * 60 * 60,
    LOGIN_WINDOW: 15 * 60,
    LOGIN_MAX_ATTEMPTS: 8,

    MAX_USERS: 1000,

    DEFAULT_QUOTA_GB: 10,
    DEFAULT_EXPIRY_DAYS: 30,
    DEFAULT_MAX_DEVICES: 1,

    MAX_QUOTA_GB: 10000,
    MAX_EXPIRY_DAYS: 3650,
    MAX_DEVICES: 100,

    PASSWORD_MIN_LENGTH: 10,

    USER_PREFIX: "user:",
    SESSION_PREFIX: "session:",
    LOGIN_PREFIX: "login:",
    AUDIT_PREFIX: "audit:",

    ADMIN_KEY: "system:admin",
    SETTINGS_KEY: "system:settings"
};

/* ============================================================
   BASIC HELPERS
   ============================================================ */

const encoder = new TextEncoder();

function now() {
    return Date.now();
}

function uuid() {
    return crypto.randomUUID();
}

function bytesFromGB(gb) {
    return Math.floor(Number(gb) * 1024 * 1024 * 1024);
}

function gbFromBytes(bytes) {
    return Number(bytes || 0) / (1024 * 1024 * 1024);
}

function expiryFromDays(days) {
    return new Date(
        now() + Number(days) * 86400000
    ).toISOString();
}

function isExpired(date) {
    return !date || Date.parse(date) <= now();
}

function json(data, status = 200, extra = {}) {
    const headers = new Headers({
        "Content-Type": "application/json; charset=utf-8",
        "Cache-Control": "no-store",
        ...extra
    });

    return new Response(JSON.stringify(data), {
        status,
        headers
    });
}

function text(data, status = 200, extra = {}) {
    const headers = new Headers({
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "no-store",
        ...extra
    });

    return new Response(data, {
        status,
        headers
    });
}

function unauthorized(message = "احراز هویت نشده است") {
    return json({
        success: false,
        error: message
    }, 401);
}

function forbidden(message = "دسترسی غیرمجاز") {
    return json({
        success: false,
        error: message
    }, 403);
}

function badRequest(message) {
    return json({
        success: false,
        error: message
    }, 400);
}

function serverError() {
    return json({
        success: false,
        error: "خطای داخلی سرور"
    }, 500);
}

/* ============================================================
   SECURITY HEADERS
   ============================================================ */

function securityHeaders(response) {
    const headers = new Headers(response.headers);

    headers.set(
        "X-Content-Type-Options",
        "nosniff"
    );

    headers.set(
        "X-Frame-Options",
        "DENY"
    );

    headers.set(
        "Referrer-Policy",
        "no-referrer"
    );

    headers.set(
        "Permissions-Policy",
        "camera=(), microphone=(), geolocation=()"
    );

    headers.set(
        "Content-Security-Policy",
        [
            "default-src 'self'",
            "script-src 'self' 'unsafe-inline'",
            "style-src 'self' 'unsafe-inline'",
            "img-src 'self' data:",
            "connect-src 'self'",
            "frame-ancestors 'none'"
        ].join("; ")
    );

    return new Response(
        response.body,
        {
            status: response.status,
            statusText: response.statusText,
            headers
        }
    );
}

/* ============================================================
   CRYPTO
   ============================================================ */

function randomBytes(length = 32) {
    const data = new Uint8Array(length);
    crypto.getRandomValues(data);
    return data;
}

function bytesToHex(bytes) {
    return [...bytes]
        .map(x => x.toString(16).padStart(2, "0"))
        .join("");
}

function randomToken() {
    return bytesToHex(randomBytes(32));
}

function constantTimeEqual(a, b) {
    if (typeof a !== "string" || typeof b !== "string") {
        return false;
    }

    if (a.length !== b.length) {
        return false;
    }

    let result = 0;

    for (let i = 0; i < a.length; i++) {
        result |= a.charCodeAt(i) ^ b.charCodeAt(i);
    }

    return result === 0;
}

async function sha256(value) {
    const hash = await crypto.subtle.digest(
        "SHA-256",
        encoder.encode(value)
    );

    return bytesToHex(new Uint8Array(hash));
}

/* ============================================================
   PASSWORD HASHING
   ============================================================ */

const PBKDF2_ITERATIONS = 310000;

async function derivePassword(password, salt) {
    const key = await crypto.subtle.importKey(
        "raw",
        encoder.encode(password),
        "PBKDF2",
        false,
        ["deriveBits"]
    );

    const bits = await crypto.subtle.deriveBits(
        {
            name: "PBKDF2",
            salt: encoder.encode(salt),
            iterations: PBKDF2_ITERATIONS,
            hash: "SHA-256"
        },
        key,
        256
    );

    return bytesToHex(new Uint8Array(bits));
}

async function hashPassword(password) {
    const salt = randomToken();

    const hash = await derivePassword(
        password,
        salt
    );

    return {
        algorithm: "PBKDF2-SHA256",
        iterations: PBKDF2_ITERATIONS,
        salt,
        hash
    };
}

async function verifyPassword(password, stored) {
    if (
        !stored ||
        !stored.salt ||
        !stored.hash
    ) {
        return false;
    }

    const hash = await derivePassword(
        password,
        stored.salt
    );

    return constantTimeEqual(
        hash,
        stored.hash
    );
}

/* ============================================================
   COOKIE
   ============================================================ */

function parseCookies(request) {
    const header = request.headers.get("Cookie") || "";
    const cookies = {};

    for (const part of header.split(";")) {
        const index = part.indexOf("=");

        if (index === -1) continue;

        const key = part
            .slice(0, index)
            .trim();

        const value = part
            .slice(index + 1)
            .trim();

        cookies[key] = value;
    }

    return cookies;
}

function sessionCookie(token) {
    return [
        `ajb_session=${token}`,
        "Path=/",
        "HttpOnly",
        "Secure",
        "SameSite=Strict",
        `Max-Age=${CONFIG.SESSION_TTL}`
    ].join("; ");
}

function deleteSessionCookie() {
    return [
        "ajb_session=",
        "Path=/",
        "HttpOnly",
        "Secure",
        "SameSite=Strict",
        "Max-Age=0"
    ].join("; ");
}

/* ============================================================
   DATABASE
   ============================================================ */

class Database {

    constructor(env) {
        if (!env.KV) {
            throw new Error(
                "Cloudflare KV binding 'KV' is missing"
            );
        }

        this.kv = env.KV;
    }

    async get(key) {
        return await this.kv.get(
            key,
            { type: "json" }
        );
    }

    async put(key, value) {
        await this.kv.put(
            key,
            JSON.stringify(value)
        );
    }

    async del(key) {
        await this.kv.delete(key);
    }

    async getSettings() {
        const settings =
            await this.get(CONFIG.SETTINGS_KEY);

        return settings || {
            defaultQuotaGB:
                CONFIG.DEFAULT_QUOTA_GB,

            defaultExpiryDays:
                CONFIG.DEFAULT_EXPIRY_DAYS,

            defaultMaxDevices:
                CONFIG.DEFAULT_MAX_DEVICES
        };
    }

    async saveSettings(settings) {
        await this.put(
            CONFIG.SETTINGS_KEY,
            settings
        );

        return settings;
    }

    async getAdmin() {
        return await this.get(
            CONFIG.ADMIN_KEY
        );
    }

    async saveAdmin(admin) {
        await this.put(
            CONFIG.ADMIN_KEY,
            admin
        );
    }

    async getUser(id) {
        return await this.get(
            CONFIG.USER_PREFIX + id
        );
    }

    async saveUser(user) {
        await this.put(
            CONFIG.USER_PREFIX + user.id,
            user
        );
    }

    async deleteUser(id) {
        await this.del(
            CONFIG.USER_PREFIX + id
        );
    }

    async listUsers() {
        const result = [];
        let cursor;

        do {
            const page = await this.kv.list({
                prefix: CONFIG.USER_PREFIX,
                cursor,
                limit: 1000
            });

            for (const key of page.keys) {
                const user =
                    await this.get(key.name);

                if (user) {
                    result.push(user);
                }
            }

            cursor = page.list_complete
                ? undefined
                : page.cursor;

        } while (cursor);

        return result;
    }

    async countUsers() {
        const users =
            await this.listUsers();

        return users.length;
    }

    async createUser(data) {

        const count =
            await this.countUsers();

        if (count >= CONFIG.MAX_USERS) {
            throw new Error(
                "حداکثر تعداد کاربران تکمیل شده است"
            );
        }

        const username =
            validateUsername(data.username);

        const existing =
            await this.findUserByUsername(username);

        if (existing) {
            throw new Error(
                "این نام کاربری قبلاً ثبت شده است"
            );
        }

        const settings =
            await this.getSettings();

        const quotaGB =
            normalizeNumber(
                data.quotaGB,
                settings.defaultQuotaGB
            );

        const expiryDays =
            normalizeInteger(
                data.expiryDays,
                settings.defaultExpiryDays
            );

        const maxDevices =
            normalizeInteger(
                data.maxDevices,
                settings.defaultMaxDevices
            );

        validateQuota(quotaGB);
        validateExpiry(expiryDays);
        validateDevices(maxDevices);

        const id =
            "usr_" +
            uuid().replaceAll("-", "");

        const subscriptionToken =
            randomToken();

        const user = {
            id,

            username,

            subscriptionToken,

            quota: {
                limitBytes:
                    bytesFromGB(quotaGB),

                usedBytes: 0
            },

            expiresAt:
                expiryFromDays(expiryDays),

            maxDevices,

            activeDevices: 0,

            enabled:
                data.enabled !== false,

            createdAt:
                new Date().toISOString(),

            updatedAt:
                new Date().toISOString(),

            lastSeenAt: null
        };

        await this.saveUser(user);

        return user;
    }

    async findUserByUsername(username) {
        const users =
            await this.listUsers();

        return users.find(
            user =>
                user.username === username
        ) || null;
    }

    async findBySubscription(token) {
        const users =
            await this.listUsers();

        return users.find(
            user =>
                constantTimeEqual(
                    user.subscriptionToken,
                    token
                )
        ) || null;
    }
}

/* ============================================================
   VALIDATION
   ============================================================ */

function validateUsername(username) {

    if (typeof username !== "string") {
        throw new Error(
            "نام کاربری نامعتبر است"
        );
    }

    username =
        username.trim();

    if (
        username.length < 3 ||
        username.length > 32
    ) {
        throw new Error(
            "نام کاربری باید بین ۳ تا ۳۲ کاراکتر باشد"
        );
    }

    if (
        !/^[a-zA-Z0-9_.-]+$/.test(username)
    ) {
        throw new Error(
            "نام کاربری فقط می‌تواند شامل حروف، اعداد، نقطه، خط تیره و زیرخط باشد"
        );
    }

    return username;
}

function normalizeNumber(value, fallback) {

    if (
        value === undefined ||
        value === null ||
        value === ""
    ) {
        return Number(fallback);
    }

    const number =
        Number(value);

    if (!Number.isFinite(number)) {
        throw new Error(
            "مقدار عددی نامعتبر است"
        );
    }

    return number;
}

function normalizeInteger(value, fallback) {

    const number =
        normalizeNumber(
            value,
            fallback
        );

    if (!Number.isInteger(number)) {
        throw new Error(
            "مقدار باید عدد صحیح باشد"
        );
    }

    return number;
}

function validateQuota(gb) {

    if (
        !Number.isFinite(gb) ||
        gb <= 0 ||
        gb > CONFIG.MAX_QUOTA_GB
    ) {
        throw new Error(
            `حجم باید بین 0 و ${CONFIG.MAX_QUOTA_GB} GB باشد`
        );
    }
}

function validateExpiry(days) {

    if (
        !Number.isInteger(days) ||
        days <= 0 ||
        days > CONFIG.MAX_EXPIRY_DAYS
    ) {
        throw new Error(
            "مدت انقضا نامعتبر است"
        );
    }
}

function validateDevices(count) {

    if (
        !Number.isInteger(count) ||
        count <= 0 ||
        count > CONFIG.MAX_DEVICES
    ) {
        throw new Error(
            "تعداد دستگاه نامعتبر است"
        );
    }
}

function validatePassword(password) {

    if (
        typeof password !== "string" ||
        password.length <
        CONFIG.PASSWORD_MIN_LENGTH
    ) {
        throw new Error(
            `رمز عبور باید حداقل ${CONFIG.PASSWORD_MIN_LENGTH} کاراکتر باشد`
        );
    }

    if (password.length > 128) {
        throw new Error(
            "رمز عبور بیش از حد طولانی است"
        );
    }
}

/* ============================================================
   SESSION MANAGER
   ============================================================ */

class SessionManager {

    constructor(db) {
        this.db = db;
    }

    async create(username) {

        const token =
            randomToken();

        const session = {
            username,

            createdAt:
                new Date().toISOString(),

            expiresAt:
                new Date(
                    now() +
                    CONFIG.SESSION_TTL *
                    1000
                ).toISOString()
        };

        await this.db.put(
            CONFIG.SESSION_PREFIX + token,
            session
        );

        return token;
    }

    async get(request) {

        const cookies =
            parseCookies(request);

        const token =
            cookies.ajb_session;

        if (!token) {
            return null;
        }

        const session =
            await this.db.get(
                CONFIG.SESSION_PREFIX +
                token
            );

        if (!session) {
            return null;
        }

        if (
            Date.parse(session.expiresAt) <=
            now()
        ) {
            await this.destroyToken(token);
            return null;
        }

        return {
            token,
            ...session
        };
    }

    async destroyToken(token) {

        if (!token) return;

        await this.db.del(
            CONFIG.SESSION_PREFIX +
            token
        );
    }

    async destroy(request) {

        const cookies =
            parseCookies(request);

        if (cookies.ajb_session) {
            await this.destroyToken(
                cookies.ajb_session
            );
        }
    }
}

/* ============================================================
   CSRF
   ============================================================ */

async function getCSRF(request, session) {

    const header =
        request.headers.get(
            "X-CSRF-Token"
        );

    if (!header || !session) {
        return false;
    }

    const expected =
        await sha256(
            session.token +
            session.expiresAt
        );

    return constantTimeEqual(
        header,
        expected
    );
}

/* ============================================================
   LOGIN RATE LIMIT
   ============================================================ */

async function loginAllowed(db, ip) {

    const key =
        CONFIG.LOGIN_PREFIX +
        (await sha256(ip));

    const state =
        await db.get(key);

    if (!state) {
        return true;
    }

    if (
        now() - state.windowStart >
        CONFIG.LOGIN_WINDOW * 1000
    ) {
        return true;
    }

    return (
        state.attempts <
        CONFIG.LOGIN_MAX_ATTEMPTS
    );
}

async function registerLoginFailure(
    db,
    ip
) {

    const key =
        CONFIG.LOGIN_PREFIX +
        (await sha256(ip));

    let state =
        await db.get(key);

    if (
        !state ||
        now() - state.windowStart >
        CONFIG.LOGIN_WINDOW * 1000
    ) {
        state = {
            attempts: 0,
            windowStart: now()
        };
    }

    state.attempts++;

    await db.put(key, state);
}

/* ============================================================
   AUDIT LOG
   ============================================================ */

async function audit(
    db,
    action,
    username,
    metadata = {}
) {

    const id =
        Date.now() +
        "_" +
        randomToken().slice(0, 12);

    await db.put(
        CONFIG.AUDIT_PREFIX + id,
        {
            id,
            action,
            username,
            metadata,
            createdAt:
                new Date().toISOString()
        }
    );
}

/* ============================================================
   USER SANITIZATION
   ============================================================ */

function publicUser(user) {

    if (!user) return null;

    const used =
        Number(user.quota?.usedBytes || 0);

    const limit =
        Number(user.quota?.limitBytes || 0);

    const percentage =
        limit > 0
            ? Math.min(
                100,
                (used / limit) * 100
            )
            : 0;

    return {
        id: user.id,
        username: user.username,

        quotaGB:
            gbFromBytes(limit),

        usedGB:
            gbFromBytes(used),

        remainingGB:
            Math.max(
                0,
                gbFromBytes(limit - used)
            ),

        usagePercent:
            Number(
                percentage.toFixed(2)
            ),

        expiresAt:
            user.expiresAt,

        maxDevices:
            user.maxDevices,

        activeDevices:
            user.activeDevices || 0,

        enabled:
            !!user.enabled,

        expired:
            isExpired(user.expiresAt),

        exhausted:
            used >= limit,

        createdAt:
            user.createdAt,

        updatedAt:
            user.updatedAt,

        lastSeenAt:
            user.lastSeenAt
    };
}

