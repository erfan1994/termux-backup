            $('userModal').classList.add('show');
        }

        function hideModal() {
            $('userModal').classList.remove('show');
        }

        function editUser(username) {
            const u = users.find(u => u.username === username);
            if (u) showModal('Edit User', u);
        }

        // ==================== NAVIGATION ====================
        function navigate(page) {
            currentPage = page;
            document.querySelectorAll('.nav-item').forEach(el => el.classList.toggle('active', el.dataset.page === page));
            document.querySelectorAll('[id^="page-"]').forEach(el => el.style.display = 'none');
            const target = $('page-' + page);
            if (target) target.style.display = 'block';
        }

        // ==================== SETTINGS ====================
        async function loadSettings() {
            const res = await api('GET', '/ajb/api/settings');
            $('defaultTraffic').value = res.default_traffic || 10;
            $('defaultExpiry').value = res.default_expiry || 30;
        }

        async function saveSettings() {
            await api('POST', '/ajb/api/settings', {
                default_traffic: parseFloat($('defaultTraffic').value) || 10,
                default_expiry: parseInt($('defaultExpiry').value) || 30
            });
            showToast('Settings saved!');
        }

        // ==================== INIT ====================
        async function init() {
            // Check auth
            const authed = await checkAuth();
            if (!authed) {
                $('loginPage').style.display = 'flex';
                $('dashboardPage').style.display = 'none';
                return;
            }

            $('loginPage').style.display = 'none';
            $('dashboardPage').style.display = 'block';

            $('adminName').textContent = currentUser?.username || 'Admin';
            $('adminAvatar').textContent = (currentUser?.username || 'A')[0].toUpperCase();

            await loadUsers();
            await loadSettings();

            // Event listeners
            document.querySelectorAll('.nav-item').forEach(el => {
                el.addEventListener('click', () => navigate(el.dataset.page));
            });

            $('addUserBtn').addEventListener('click', () => showModal('Add User'));

            $('modalCloseBtn').addEventListener('click', hideModal);
            $('userModal').addEventListener('click', e => {
                if (e.target === $('userModal')) hideModal();
            });

            $('userForm').addEventListener('submit', async e => {
                e.preventDefault();
                const edit = $('editUsername').value;
                const data = {
                    username: $('formUsername').value.trim(),
                    password: $('formPassword').value || undefined,
                    traffic_limit: parseFloat($('formTraffic').value) || undefined,
                    expiry_days: parseInt($('formExpiry').value) || undefined,
                    is_active: $('formStatus').value === 'active'
                };

                if (!data.username) return showToast('Username required', 'error');

                try {
                    if (edit) {
                        await updateUser(edit, data);
                    } else {
                        await addUser(data);
                    }
                    hideModal();
                } catch (err) {
                    showToast(err.message, 'error');
                }
            });

            $('loginForm').addEventListener('submit', async e => {
                e.preventDefault();
                try {
                    await login($('loginUsername').value, $('loginPassword').value);
                    await init();
                } catch (err) {
                    showToast(err.message, 'error');
                }
            });

            $('logoutBtn').addEventListener('click', async () => {
                await logout();
                await init();
            });

            $('changePasswordBtn').addEventListener('click', async () => {
                const pwd = $('newPassword').value.trim();
                if (!pwd) return showToast('Enter a password', 'error');
                try {
                    await api('POST', '/ajb/api/change-password', { password: pwd });
                    $('newPassword').value = '';
                    showToast('Password changed!');
                } catch (err) {
                    showToast(err.message, 'error');
                }
            });

            // Save settings
            $('defaultTraffic').addEventListener('change', saveSettings);
            $('defaultExpiry').addEventListener('change', saveSettings);

            // Search
            $('userSearch').addEventListener('input', renderUsers);

            // Show dashboard by default
            navigate('dashboard');
        }

        // Load
        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
    `
};

// ==================== API HANDLERS ====================
const API = {
    // Session management
    sessions: new Map(),

    createSession(username) {
        const token = crypto.randomUUID();
        this.sessions.set(token, { username, expires: Date.now() + 86400000 });
        return token;
    },

    validateSession(token) {
        const session = this.sessions.get(token);
        if (!session) return null;
        if (session.expires < Date.now()) {
            this.sessions.delete(token);
            return null;
        }
        return session;
    },

    async handleLogin(request, env) {
        try {
            const { username, password } = await request.json();
            const users = await DB.getUsers();
            const user = users[username];

            if (!user || user.password !== password) {
                return Response.json({ success: false, message: 'Invalid credentials' }, { status: 401 });
            }

            const token = this.createSession(username);
            const response = Response.json({
                success: true,
                user: { username: user.username, role: user.role }
            });

            response.headers.set('Set-Cookie', `ajb_session=${token}; Path=/; HttpOnly; Max-Age=86400; SameSite=Strict`);

            return response;
        } catch {
            return Response.json({ success: false, message: 'Invalid request' }, { status: 400 });
        }
    },

    async handleLogout(request) {
        const cookie = request.headers.get('Cookie');
        if (cookie) {
            const match = cookie.match(/ajb_session=([^;]+)/);
            if (match) this.sessions.delete(match[1]);
        }
        const response = Response.json({ success: true });
        response.headers.set('Set-Cookie', 'ajb_session=; Path=/; Max-Age=0; HttpOnly');
        return response;
    },

    async handleMe(request) {
        const user = await this.getUserFromRequest(request);
        if (!user) {
            return Response.json({ success: false, message: 'Unauthorized' }, { status: 401 });
        }
        return Response.json({ success: true, user: { username: user.username, role: user.role } });
    },

    async getUserFromRequest(request) {
        const cookie = request.headers.get('Cookie');
        if (!cookie) return null;
        const match = cookie.match(/ajb_session=([^;]+)/);
        if (!match) return null;
        const session = this.validateSession(match[1]);
        if (!session) return null;
        const users = await DB.getUsers();
        return users[session.username] || null;
    }
};

// ==================== MAIN FETCH HANDLER ====================
export default {
    async fetch(request, env) {
        const url = new URL(request.url);
        const path = url.pathname;

        // Initialize DB
        await DB.init(env);

        // API Routes
        if (path.startsWith('/ajb/api/')) {
            const apiPath = path.replace('/ajb/api/', '');

            // Public endpoints
            if (apiPath === 'login' && request.method === 'POST') {
                return API.handleLogin(request, env);
            }

            if (apiPath === 'logout' && request.method === 'POST') {
                return API.handleLogout(request);
            }

            // Protected endpoints
            const user = await API.getUserFromRequest(request);
            if (!user) {
                return Response.json({ success: false, message: 'Unauthorized' }, { status: 401 });
            }

            switch (apiPath) {
                case 'me':
                    return API.handleMe(request);

                case 'users':
                    if (request.method === 'GET') {
                        const users = await DB.getUsers();
                        const userList = Object.values(users).filter(u => u.username !== 'admin');
                        return Response.json({ success: true, users: userList });
                    }
                    if (request.method === 'POST') {
                        const data = await request.json();
                        const newUser = await DB.createUser(data.username, {
                            password: data.password,
                            traffic_limit: data.traffic_limit || CONFIG.DEFAULT_TRAFFIC,
                            expiry_date: data.expiry_days ? new Date(Date.now() + data.expiry_days * 86400000).toISOString() : undefined,
                            is_active: data.is_active !== false
                        });
                        return Response.json({ success: true, user: newUser });
                    }
                    break;

                case 'users/reset':
                    if (request.method === 'POST') {
                        const { username } = await request.json();
                        const updated = await DB.resetUserTraffic(username);
                        return Response.json({ success: true, user: updated });
                    }
                    break;

                case 'settings':
                    if (request.method === 'GET') {
                        const settings = await env.kv.get('ajb_settings', { type: 'json' }) || {
                            default_traffic: CONFIG.DEFAULT_TRAFFIC,
                            default_expiry: CONFIG.DEFAULT_EXPIRY_DAYS
                        };
                        return Response.json({ success: true, ...settings });
                    }
                    if (request.method === 'POST') {
                        const data = await request.json();
                        await env.kv.put('ajb_settings', JSON.stringify(data));
                        return Response.json({ success: true });
                    }
                    break;

                case 'change-password':
                    if (request.method === 'POST') {
                        const { password } = await request.json();
                        const users = await DB.getUsers();
                        users[user.username].password = password;
                        await DB.saveUsers(users);
                        return Response.json({ success: true });
                    }
                    break;

                default:
                    if (apiPath.startsWith('users/')) {
                        const username = apiPath.replace('users/', '');
                        if (request.method === 'PUT') {
                            const data = await request.json();
                            const updated = await DB.updateUser(username, data);
                            return Response.json({ success: true, user: updated });
                        }
                        if (request.method === 'DELETE') {
                            await DB.deleteUser(username);
                            return Response.json({ success: true });
                        }
                        if (request.method === 'POST' && apiPath.endsWith('/reset')) {
                            const updated = await DB.resetUserTraffic(username);
                            return Response.json({ success: true, user: updated });
                        }
                    }
                    break;
            }

            return Response.json({ success: false, message: 'Not found' }, { status: 404 });
        }

        // Subscription endpoint
        if (path.startsWith('/ajb/sub/')) {
            const id = path.replace('/ajb/sub/', '');
            const subscription = await DB.getSubscriptionByID(id);

            if (!subscription) {
                return new Response('Invalid subscription', { status: 404 });
            }

            // Check if expired or inactive
            if (!subscription.is_active || new Date(subscription.expiry_date) < new Date()) {
                return new Response('Subscription expired or inactive', { status: 403 });
            }

            // Generate subscription config (example: V2Ray config)
            const config = {
                v: '2',
                ps: `AJB-VIP-${subscription.username}`,
                add: 'proxy.example.com',
                port: '443',
                id: subscription.subscription_id,
                aid: '0',
                net: 'ws',
                type: 'none',
                host: 'proxy.example.com',
                path: '/',
                tls: 'tls'
            };

            // Track usage (example: increment traffic)
            // In production, you'd update traffic_used based on actual usage

            return new Response(JSON.stringify(config), {
                headers: {
                    'Content-Type': 'application/json',
                    'Cache-Control': 'no-store',
                    'Profile-Title': `AJB-VIP-${subscription.username}`
                }
            });
        }

        // Panel UI
        if (path === '/ajb' || path === '/ajb/') {
            return new Response(HTML.dashboard, {
                headers: { 'Content-Type': 'text/html; charset=utf-8' }
            });
        }

        // Redirect to panel
        if (path === '/') {
            return Response.redirect('/ajb', 302);
        }

        return new Response('Not Found', { status: 404 });
    }
};
