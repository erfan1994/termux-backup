                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="btn btn-close" id="modalCloseBtn">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="modalSubmitBtn">Save</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="toast-container" id="toastContainer"></div>
    </div>
    <script>
    // ============================================================
    // بخش ۱۴: جاوااسکریپت پنل
    // ============================================================
    
    let users = [];
    let currentUser = null;
    let currentPage = 'dashboard';

    function $(id) { return document.getElementById(id); }

    function showToast(message, type = 'success') {
        const container = $('toastContainer');
        const toast = document.createElement('div');
        toast.className = 'toast ' + type;
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(30px)';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }

    async function api(method, endpoint, data) {
        const opts = { method, headers: { 'Content-Type': 'application/json' } };
        if (data) opts.body = JSON.stringify(data);
        const res = await fetch(endpoint, opts);
        const json = await res.json();
        if (!json.success) throw new Error(json.message || 'API error');
        return json;
    }

    // احراز هویت
    async function login(username, password) {
        const res = await api('POST', '/ajb/api/login', { username, password });
        currentUser = res.user;
        showToast('Login successful!');
        return res;
    }

    async function logout() {
        await api('POST', '/ajb/api/logout');
        currentUser = null;
        showToast('Logged out');
    }

    async function checkAuth() {
        try {
            const res = await api('GET', '/ajb/api/me');
            currentUser = res.user;
            return true;
        } catch {
            return false;
        }
    }

    // مدیریت کاربران
    async function loadUsers() {
        const res = await api('GET', '/ajb/api/users');
        users = res.users;
        renderUsers();
        updateStats();
        renderSubscriptions();
        return users;
    }

    async function addUser(data) {
        const res = await api('POST', '/ajb/api/users', data);
        await loadUsers();
        showToast('User created successfully!');
        return res;
    }

    async function updateUser(username, data) {
        const res = await api('PUT', '/ajb/api/users/' + username, data);
        await loadUsers();
        showToast('User updated successfully!');
        return res;
    }

    async function deleteUser(username) {
        if (!confirm('Delete user "' + username + '"?')) return;
        await api('DELETE', '/ajb/api/users/' + username);
        await loadUsers();
        showToast('User deleted');
    }

    async function resetTraffic(username) {
        await api('POST', '/ajb/api/users/' + username + '/reset');
        await loadUsers();
        showToast('Traffic reset!');
    }

    // رندر
    function renderUsers() {
        const tbody = $('usersTableBody');
        const search = $('userSearch')?.value?.toLowerCase() || '';
        const filtered = users.filter(u => u.username !== 'admin' && u.username.toLowerCase().includes(search));

        tbody.innerHTML = filtered.map(u => {
            const remaining = u.traffic_limit - u.traffic_used;
            const percent = u.traffic_limit > 0 ? Math.min((u.traffic_used / u.traffic_limit) * 100, 100) : 0;
            const isExpired = new Date(u.expiry_date) < new Date();
            const status = !u.is_active ? 'inactive' : isExpired ? 'expired' : 'active';
            const statusMap = {
                active: '<span class="status-badge active">Active</span>',
                expired: '<span class="status-badge expired">Expired</span>',
                inactive: '<span class="status-badge inactive">Inactive</span>'
            };
            let barClass = 'fill';
            if (percent > 80) barClass += ' danger';
            else if (percent > 50) barClass += ' warning';
            return '<tr><td><strong>' + u.username + '</strong></td><td>' + u.traffic_used.toFixed(2) + ' / ' + u.traffic_limit + ' GB<div class="traffic-bar"><div class="' + barClass + '" style="width:' + percent + '%;"></div></div></td><td>' + new Date(u.expiry_date).toLocaleDateString() + '</td><td>' + statusMap[status] + '</td><td><button class="btn btn-success btn-sm" onclick="resetTraffic(\'' + u.username + '\')">↺</button> <button class="btn btn-warning btn-sm" onclick="editUser(\'' + u.username + '\')">✎</button> <button class="btn btn-danger btn-sm" onclick="deleteUser(\'' + u.username + '\')">×</button></td></tr>';
        }).join('');

        $('userCount').textContent = filtered.length;
    }

    function updateStats() {
        const nonAdmin = users.filter(u => u.username !== 'admin');
        const total = nonAdmin.length;
        const active = nonAdmin.filter(u => u.is_active && new Date(u.expiry_date) > new Date()).length;
        const totalTraffic = nonAdmin.reduce((s, u) => s + u.traffic_limit, 0);
        const usedTraffic = nonAdmin.reduce((s, u) => s + u.traffic_used, 0);
        $('statTotal').textContent = total;
        $('statActive').textContent = active;
        $('statTraffic').textContent = totalTraffic.toFixed(0) + ' GB';
        $('statUsed').textContent = usedTraffic.toFixed(1) + ' GB';
    }

    function renderSubscriptions() {
        const tbody = $('subscriptionsTableBody');
        const nonAdmin = users.filter(u => u.username !== 'admin');
        tbody.innerHTML = nonAdmin.map(u => {
            const isExpired = new Date(u.expiry_date) < new Date();
            const status = !u.is_active ? 'inactive' : isExpired ? 'expired' : 'active';
            const statusMap = {
                active: '<span class="status-badge active">Active</span>',
                expired: '<span class="status-badge expired">Expired</span>',
                inactive: '<span class="status-badge inactive">Inactive</span>'
            };
            const url = window.location.origin + '/ajb/sub/' + u.subscription_id;
            return '<tr><td><strong>' + u.username + '</strong></td><td style="font-size:12px; word-break:break-all; color:var(--text-muted);">' + url + '</td><td>' + statusMap[status] + '</td><td><button class="btn btn-primary btn-sm" onclick="copySubUrl(\'' + url + '\')">📋 Copy</button></td></tr>';
        }).join('');
    }

    function copySubUrl(url) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(() => showToast('Subscription URL copied!'));
        } else {
            const input = document.createElement('input');
            input.value = url;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            showToast('Subscription URL copied!');
        }
    }

    // مودال
    function showModal(title, data = null) {
        $('modalTitle').textContent = title;
        $('editUsername').value = data?.username || '';
        $('formUsername').value = data?.username || '';
        $('formUsername').disabled = !!data;
        $('formPassword').value = '';
        $('formTraffic').value = data?.traffic_limit || '';
        $('formExpiry').value = data ? Math.ceil((new Date(data.expiry_date) - new Date()) / 86400000) : '';
        $('formStatus').value = data?.is_active !== false ? 'active' : 'inactive';
        $('userModal').classList.add('show');
    }

    function hideModal() {
        $('userModal').classList.remove('show');
    }

    function editUser(username) {
        const u = users.find(u => u.username === username);
        if (u) showModal('Edit User', u);
    }

    // ناوبری
    function navigate(page) {
        currentPage = page;
        document.querySelectorAll('.nav-item').forEach(el => el.classList.toggle('active', el.dataset.page === page));
        document.querySelectorAll('[id^="page-"]').forEach(el => el.style.display = 'none');
        const target = $('page-' + page);
        if (target) target.style.display = 'block';
    }

    // تنظیمات
    async function loadSettings() {
        const res = await api('GET', '/ajb/api/settings');
        $('defaultTraffic').value = res.default_traffic || 10;
        $('defaultExpiry').value = res.default_expiry || 30;
    }

    async function saveSettings() {
        await api('POST', '/ajb/api/settings', {
            default_traffic: parseFloat($('defaultTraffic').value) || 10,
            default_expiry: parseInt($('defaultExpiry').value) || 30
        });
        showToast('Settings saved!');
    }

    // مقداردهی اولیه
    async function init() {
        const authed = await checkAuth();
        if (!authed) {
            $('loginPage').style.display = 'flex';
            $('dashboardPage').style.display = 'none';
            return;
        }
        $('loginPage').style.display = 'none';
        $('dashboardPage').style.display = 'block';
        $('adminName').textContent = currentUser?.username || 'Admin';
        $('adminAvatar').textContent = (currentUser?.username || 'A')[0].toUpperCase();
        await loadUsers();
        await loadSettings();

        document.querySelectorAll('.nav-item').forEach(el => {
            el.addEventListener('click', () => navigate(el.dataset.page));
        });

        $('addUserBtn').addEventListener('click', () => showModal('Add User'));
        $('modalCloseBtn').addEventListener('click', hideModal);
        $('userModal').addEventListener('click', e => {
            if (e.target === $('userModal')) hideModal();
        });

        $('userForm').addEventListener('submit', async e => {
            e.preventDefault();
            const edit = $('editUsername').value;
            const data = {
                username: $('formUsername').value.trim(),
                password: $('formPassword').value || undefined,
                traffic_limit: parseFloat($('formTraffic').value) || undefined,
                expiry_days: parseInt($('formExpiry').value) || undefined,
                is_active: $('formStatus').value === 'active'
            };
            if (!data.username) return showToast('Username required', 'error');
            try {
                if (edit) {
                    await updateUser(edit, data);
                } else {
                    await addUser(data);
                }
                hideModal();
            } catch (err) {
                showToast(err.message, 'error');
            }
        });

        $('loginForm').addEventListener('submit', async e => {
            e.preventDefault();
            try {
                await login($('loginUsername').value, $('loginPassword').value);
                await init();
            } catch (err) {
                showToast(err.message, 'error');
            }
        });

        $('logoutBtn').addEventListener('click', async () => {
            await logout();
            await init();
        });

        $('changePasswordBtn').addEventListener('click', async () => {
            const pwd = $('newPassword').value.trim();
            if (!pwd) return showToast('Enter a password', 'error');
            try {
                await api('POST', '/ajb/api/change-password', { password: pwd });
                $('newPassword').value = '';
                showToast('Password changed!');
            } catch (err) {
                showToast(err.message, 'error');
            }
        });

        $('defaultTraffic').addEventListener('change', saveSettings);
        $('defaultExpiry').addEventListener('change', saveSettings);
        $('userSearch').addEventListener('input', renderUsers);

        navigate('dashboard');
    }

    document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>`;
