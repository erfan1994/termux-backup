// ==================== CONFIGURATION ====================
const CONFIG = {
    PANEL_NAME: 'AJB-VIP',
    PANEL_VERSION: '2.0.0',
    ADMIN_USERNAME: 'admin',
    ADMIN_PASSWORD: 'admin123',
    DEFAULT_TRAFFIC: 10, // GB
    DEFAULT_EXPIRY_DAYS: 30,
    MAX_USERS: 100,
    SESSION_SECRET: crypto.randomUUID(),
};

// ==================== DATABASE (KV Storage) ====================
const DB = {
    async init(env) {
        this.env = env;
        await this.ensureUsers();
    },

    async ensureUsers() {
        const users = await this.env.kv.get('ajb_users', { type: 'json' });
        if (!users) {
            await this.env.kv.put('ajb_users', JSON.stringify({
                admin: {
                    username: CONFIG.ADMIN_USERNAME,
                    password: CONFIG.ADMIN_PASSWORD,
                    role: 'admin',
                    created_at: new Date().toISOString()
                }
            }));
        }
    },

    async getUsers() {
        const data = await this.env.kv.get('ajb_users', { type: 'json' });
        return data || {};
    },

    async saveUsers(users) {
        await this.env.kv.put('ajb_users', JSON.stringify(users));
    },

    async getUser(username) {
        const users = await this.getUsers();
        return users[username] || null;
    },

    async createUser(username, data) {
        const users = await this.getUsers();
        if (users[username]) throw new Error('User already exists');
        if (Object.keys(users).length >= CONFIG.MAX_USERS) throw new Error('Maximum users reached');

        users[username] = {
            username,
            password: data.password || crypto.randomUUID().slice(0, 8),
            role: data.role || 'user',
            traffic_limit: data.traffic_limit || CONFIG.DEFAULT_TRAFFIC,
            traffic_used: 0,
            expiry_date: data.expiry_date || new Date(Date.now() + CONFIG.DEFAULT_EXPIRY_DAYS * 86400000).toISOString(),
            is_active: true,
            subscription_id: crypto.randomUUID(),
            created_at: new Date().toISOString(),
            last_seen: null,
            ...data
        };

        await this.saveUsers(users);
        return users[username];
    },

    async updateUser(username, data) {
        const users = await this.getUsers();
        if (!users[username]) throw new Error('User not found');
        users[username] = { ...users[username], ...data };
        await this.saveUsers(users);
        return users[username];
    },

    async deleteUser(username) {
        if (username === 'admin') throw new Error('Cannot delete admin user');
        const users = await this.getUsers();
        delete users[username];
        await this.saveUsers(users);
        return true;
    },

    async resetUserTraffic(username) {
        const users = await this.getUsers();
        if (!users[username]) throw new Error('User not found');
        users[username].traffic_used = 0;
        await this.saveUsers(users);
        return users[username];
    },

    async getUserSubscription(username) {
        const user = await this.getUser(username);
        if (!user) return null;
        return {
            id: user.subscription_id,
            username: user.username,
            traffic_limit: user.traffic_limit,
            traffic_used: user.traffic_used,
            remaining: user.traffic_limit - user.traffic_used,
            expiry: user.expiry_date,
            is_active: user.is_active,
            subscription_url: `/ajb/sub/${user.subscription_id}`
        };
    },

    async getSubscriptionByID(id) {
        const users = await this.getUsers();
        for (const [username, user] of Object.entries(users)) {
            if (user.subscription_id === id) {
                return { username, ...user };
            }
        }
        return null;
    },

    async getStats() {
        const users = await this.getUsers();
        const stats = {
            total: 0,
            active: 0,
            expired: 0,
            total_traffic: 0,
            used_traffic: 0
        };

        for (const [username, user] of Object.entries(users)) {
            if (username === 'admin') continue;
            stats.total++;
            if (user.is_active && new Date(user.expiry_date) > new Date()) {
                stats.active++;
            } else {
                stats.expired++;
            }
            stats.total_traffic += user.traffic_limit || 0;
            stats.used_traffic += user.traffic_used || 0;
        }

        return stats;
    }
};

